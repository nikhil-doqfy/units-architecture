+def _inception_date(finance_pmc_profile):
+    """Start of the since-inception window: the profile's creation date, or the
+    earliest journal date if earlier -- journals for business before Finance was
+    activated (backdated leases, migrated history) are dated before the profile."""
+    from ledger.models import JournalEntry
+
+    earliest = JournalEntry.objects.filter(finance_pmc_profile=finance_pmc_profile).aggregate(d=Min("entry_date"))["d"]
+    created = finance_pmc_profile.created.date()
+    return min(created, earliest) if earliest else created
+
